# Stripe API Keys (get from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Database (used by backend service)
# Local development:
DATABASE_URL=postgresql://hessy:hessy_dev_password@postgres:5432/hessy_ecommerce
# Production (Railway sets this automatically)
# DATABASE_URL=postgresql://user:password@host:port/database

# Redis (used by backend service)
# Local development:
REDIS_URL=redis://redis:6379
# Production (Railway sets this automatically)
# REDIS_URL=redis://host:port

# JWT Secret (change in production)
JWT_SECRET=dev_jwt_secret_change_in_production

# Node Environment
NODE_ENV=development

# Backend Port
PORT=4000

# GraphQL API URL (used by frontend)
# Local development:
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
# Production (Vercel - set to your Railway backend URL):
# NEXT_PUBLIC_GRAPHQL_URL=https://your-backend.railway.app/graphql
